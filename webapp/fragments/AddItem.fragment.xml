<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="_IDGenDialog" title="Add Item">

        <content>

            <VBox id="_IDGenVBox1" class="sapUiMediumMargin">

                <Input id="_IDGenInput" placeholder="Item ID" />

                <Input id="_IDGenInput1"
                    placeholder="Item Name"
                    class="sapUiSmallMarginTop" />
                    
                    <Select
                        id="categorySelect"
                        class="sapUiSmallMarginTop"
                        selectedKey="General">

                        <items>

                            <core:Item id="_IDGenItem1"
                                key="Image"
                                text="Image" />

                            <core:Item id="_IDGenItem2"
                                key="Video"
                                text="Video" />

                            <core:Item id="_IDGenItem3"
                                key="Document"
                                text="Document" />

                            <core:Item id="_IDGenItem4"
                                key="Marketing"
                                text="Marketing" />

                            <core:Item id="_IDGenItem5"
                                key="General"
                                text="General" />

                        </items>

                    </Select>

            </VBox>

        </content>

        <beginButton>

            <Button id="_IDGenButton2"
                text="Save"
                type="Emphasized"
                press="onAddItem" />

        </beginButton>

        <endButton>

            <Button id="_IDGenButton3"
                text="Cancel"
                press="onCloseDialog" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>