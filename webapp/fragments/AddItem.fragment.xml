<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="_IDGenDialog" title="Add Item">

        <content>

            <VBox id="_IDGenVBox1" class="sapUiMediumMargin">

                <Input id="_IDGenInput" placeholder="Item ID" />

                <Input id="_IDGenInput1"
                    placeholder="Item Name"
                    class="sapUiSmallMarginTop" />

            </VBox>

        </content>

        <beginButton>

            <Button id="_IDGenButton2"
                text="Save"
                type="Emphasized"
                press="onAddItem" />

        </beginButton>

        <endButton>

            <Button id="_IDGenButton3"
                text="Cancel"
                press="onCloseDialog" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>