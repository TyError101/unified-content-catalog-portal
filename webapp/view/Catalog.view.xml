<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="_IDGenPage1" title="Catalog Management">

        <content>

            <VBox id="_IDGenVBox3" class="sapUiMediumMargin">

                <!-- HEADER -->

                <Toolbar id="_IDGenToolbar">

                    <Title id="_IDGenTitle1"
                        text="Catalog Items"
                        level="H2" />

                </Toolbar>

                <!-- TABLE -->

                <Table
                    id="catalogTable"
                    items="{catalog>/items}"
                    class="sapUiMediumMarginTop">

                    <columns>

                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText11" text="ID" />
                        </Column>

                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText12" text="Name" />
                        </Column>

                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText13" text="Category" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem id="_IDGenColumnListItem">

                            <cells>

                                <Text id="_IDGenText14" text="{catalog>id}" />

                                <Text id="_IDGenText15" text="{catalog>name}" />

                                <Text id="_IDGenText16" text="{catalog>category}" />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>