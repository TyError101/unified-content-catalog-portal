<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="_IDGenPage1"
        title="Catalog Management">

        <content>

            <VBox id="_IDGenVBox3"
                class="sapUiMediumMargin">

                <Panel id="_IDGenPanel6"
                    headerText="Catalog Management">

                    <VBox id="_IDGenVBox4"
                        class="sapUiMediumMargin">

                        <!-- TOOLBAR -->

                        <OverflowToolbar id="_IDGenOverflowToolbar">

                            <Title id="_IDGenTitle1"
                                text="Catalog Items"
                                level="H3" />

                            <ToolbarSpacer id="_IDGenToolbarSpacer" />

                            <SearchField
                                id="_IDGenSearchField"
                                width="400px"
                                liveChange="onSearchCatalog"
                                placeholder="Search by name or category..." />

                            <Select
                                id="categoryFilter"
                                width="180px"
                                change="onFilterCategory"
                                class="sapUiTinyMarginBegin">

                                <items>

                                    <core:Item id="_IDGenItem"
                                        key="All"
                                        text="All Categories" />

                                    <core:Item id="_IDGenItem1"
                                        key="Image"
                                        text="Images" />

                                    <core:Item id="_IDGenItem2"
                                        key="Video"
                                        text="Videos" />

                                    <core:Item id="_IDGenItem6"
                                        key="Document"
                                        text="Documents" />

                                </items>

                            </Select>

                            <ToolbarSeparator id="_IDGenToolbarSeparator" />

                            <Button id="_IDGenButton"
                                text="CSV"
                                icon="sap-icon://download"
                                press="onExportCSV" />

                            <Button id="_IDGenButton3"
                                text="Excel"
                                icon="sap-icon://excel-attachment"
                                press="onExportExcel" />

                            <Button id="_IDGenButton6"
                                text="Import"
                                icon="sap-icon://upload"
                                press="onImportCSV" />

                            <Button id="_IDGenButton7"
                                text="Add Item"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press="onOpenDialog" />

                        </OverflowToolbar>

                        <!-- TABLE -->

                        <Table
                            id="catalogTable"
                            items="{catalog>/items}"
                            class="sapUiMediumMarginTop">

                            <columns>

                                <Column id="_IDGenColumn" width="130px">
                                    <Text id="_IDGenText" text="Preview" />
                                </Column>

                                <Column id="_IDGenColumn1" width="120px">
                                    <Text id="_IDGenText1" text="ID" />
                                </Column>

                                <Column id="_IDGenColumn2">
                                    <Text id="_IDGenText11" text="Name" />
                                </Column>

                                <Column id="_IDGenColumn3" width="150px">
                                    <Text id="_IDGenText12" text="Category" />
                                </Column>

                                <Column id="_IDGenColumn9" width="180px">
                                    <Text id="_IDGenText13" text="Actions" />
                                </Column>

                            </columns>

                            <items>

                                <ColumnListItem id="_IDGenColumnListItem"
                                    type="Active">

                                    <cells>

                                        <Image id="_IDGenImage"
                                            src="{catalog>thumbnail}"
                                            width="90px"
                                            height="70px"
                                            decorative="false"
                                            press="onOpenImagePreview"
                                            visible="{= ${catalog>thumbnail} ? true : false }" />

                                        <ObjectIdentifier id="_IDGenObjectIdentifier"
                                            title="{catalog>id}" />

                                        <ObjectIdentifier id="_IDGenObjectIdentifier1"
                                            title="{catalog>name}" />

                                        <ObjectStatus id="_IDGenObjectStatus"
                                            text="{catalog>category}" />

                                        <HBox id="_IDGenHBox2">

                                            <Button id="_IDGenButton8"
                                                text="Edit"
                                                icon="sap-icon://edit"
                                                type="Emphasized"
                                                press="onEditItem" />

                                            <Button id="_IDGenButton9"
                                                text="Delete"
                                                icon="sap-icon://delete"
                                                type="Reject"
                                                press="onDeleteItem"
                                                class="sapUiTinyMarginBegin" />

                                        </HBox>

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>

                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>