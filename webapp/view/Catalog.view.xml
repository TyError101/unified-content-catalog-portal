<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="_IDGenPage1" title="Catalog Management">

        <content>

            <VBox id="_IDGenVBox2" class="sapUiMediumMargin">

                <Toolbar id="_IDGenToolbar">

                    <Title id="_IDGenTitle"
                        text="Catalog Items"
                        level="H2" />

                    <ToolbarSpacer id="_IDGenToolbarSpacer" />

                    <SearchField id="_IDGenSearchField"
                        width="300px"
                        placeholder="Search item..."
                        liveChange="onSearch" />

                    <Button id="_IDGenButton"
                        text="Add Item"
                        type="Emphasized"
                        press="onOpenDialog"
                        class="sapUiTinyMarginBegin" />

                </Toolbar>

                <Table
                    id="catalogTable"
                    items="{catalog>/items}"
                    class="sapUiMediumMarginTop">

                    <columns>

                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText" text="ID" />
                        </Column>

                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText1" text="Name" />
                        </Column>

                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText2" text="Category" />
                        </Column>

                        <Column id="_IDGenColumn4">
                            <Text id="_IDGenText3" text="Action" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem id="_IDGenColumnListItem">

                            <cells>

                                <Text id="_IDGenText4" text="{catalog>id}" />

                                <Text id="_IDGenText5" text="{catalog>name}" />

                                <Text id="_IDGenText6" text="{catalog>category}" />

                                <HBox id="_IDGenHBox">

                                    <Button id="_IDGenButton1"
                                        text="Edit"
                                        type="Emphasized"
                                        press="onEditItem" />

                                    <Button id="_IDGenButton4"
                                        text="Delete"
                                        type="Reject"
                                        press="onDeleteItem"
                                        class="sapUiTinyMarginBegin" />

                                </HBox>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>