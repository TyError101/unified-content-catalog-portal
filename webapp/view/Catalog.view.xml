<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="_IDGenPage1" title="Catalog Management">

        <content>

            <VBox id="_IDGenVBox3" class="sapUiMediumMargin">

                <!-- HEADER -->

                <Toolbar id="_IDGenToolbar">

                    <Title id="_IDGenTitle1"
                        text="Catalog Items"
                        level="H2" />

                    <ToolbarSpacer id="_IDGenToolbarSpacer" />

                    <Button id="_IDGenButton3"
                        text="Add Item"
                        type="Emphasized"
                        press="onOpenDialog" />

                </Toolbar>

                <!-- TABLE -->

                <Table
                    id="catalogTable"
                    items="{catalog>/items}"
                    class="sapUiMediumMarginTop">

                    <columns>

                        <Column id="_IDGenColumn9" width="120px">
                            <Text id="_IDGenText25" text="Preview" />
                        </Column>

                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText" text="ID" />
                        </Column>

                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText11" text="Name" />
                        </Column>

                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText12" text="Category" />
                        </Column>

                        <Column id="_IDGenColumn3">
                            <Text id="_IDGenText13" text="Actions" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem id="_IDGenColumnListItem">

                            <cells>

                                <Image id="_IDGenImage"
                                    src="{catalog>thumbnail}"
                                    width="80px"
                                    height="60px"
                                    visible="{= ${catalog>thumbnail} ? true : false }" />

                                <Text id="_IDGenText14" text="{catalog>id}" />

                                <Text id="_IDGenText15" text="{catalog>name}" />

                                <Text id="_IDGenText16" text="{catalog>category}" />

                                <HBox id="_IDGenHBox">

                                    <Button id="_IDGenButton6"
                                        text="Edit"
                                        type="Emphasized"
                                        press="onEditItem" />

                                    <Button id="_IDGenButton7"
                                        text="Delete"
                                        type="Reject"
                                        press="onDeleteItem"
                                        class="sapUiTinyMarginBegin" />

                                </HBox>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>