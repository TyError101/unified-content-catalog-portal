<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Catalog"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="_IDGenPage1" title="Catalog Management">

        <content>

            <VBox id="_IDGenVBox2" class="sapUiMediumMargin">

                <Toolbar id="_IDGenToolbar">

                    <Title id="_IDGenTitle" text="Catalog Items" />

                    <ToolbarSpacer id="_IDGenToolbarSpacer" />

                    <SearchField id="_IDGenSearchField"
                        width="250px"
                        liveChange="onSearch"
                        placeholder="Search item..." />

                    <Button id="_IDGenButton"
                        text="Add Item"
                        type="Emphasized"
                        press="onOpenDialog" />

                </Toolbar>

                <Table
                    id="catalogTable"
                    items="{catalog>/items}">

                    <columns>

                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText" text="ID" />
                        </Column>

                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText1" text="Name" />
                        </Column>

                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText2" text="Category" />
                        </Column>

                        <Column id="_IDGenColumn4">
                            <Text id="_IDGenText6" text="Action" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem id="_IDGenColumnListItem1">

                            <cells>

                                <Text id="_IDGenText3" text="{catalog>id}" />

                                <Text id="_IDGenText4" text="{catalog>name}" />

                                <Text id="_IDGenText5" text="{catalog>category}" />

                                <Button id="_IDGenButton1"
                                    text="Delete"
                                    type="Reject"
                                    press="onDeleteItem" />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>