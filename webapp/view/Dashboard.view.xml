<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="_IDGenPage3" title="Dashboard">

        <content>

            <VBox id="_IDGenVBox" class="sapUiMediumMargin">

                <!-- TITLE -->

                <Title id="_IDGenTitle"
                    text="Unified Content &amp; Catalog Management Portal"
                    level="H1" />

                <Text id="_IDGenText1"
                    text="Welcome to the SAPUI5 media and catalog management application."
                    class="sapUiSmallMarginTop" />

                <!-- MODULE PANEL -->

                <Panel id="_IDGenPanel"
                    headerText="Application Modules"
                    class="sapUiLargeMarginTop">

                    <VBox id="_IDGenVBox1" class="sapUiMediumMargin">

                        <Text id="_IDGenText3"
                            text="• Catalog Management" />

                        <Text id="_IDGenText4"
                            text="• Media Upload Center"
                            class="sapUiTinyMarginTop" />

                        <Text id="_IDGenText5"
                            text="• Upload History Tracking"
                            class="sapUiTinyMarginTop" />

                        <Text id="_IDGenText6"
                            text="• Search and CRUD Operations"
                            class="sapUiTinyMarginTop" />

                    </VBox>

                </Panel>

                <!-- SYSTEM INFO -->

                <Panel id="_IDGenPanel1"
                    headerText="System Information"
                    class="sapUiLargeMarginTop">

                    <VBox id="_IDGenVBox2" class="sapUiMediumMargin">

                        <Text id="_IDGenText7"
                            text="Framework: SAPUI5" />

                        <Text id="_IDGenText8"
                            text="Architecture: MVC"
                            class="sapUiTinyMarginTop" />

                        <Text id="_IDGenText9"
                            text="UI Type: Responsive Web Application"
                            class="sapUiTinyMarginTop" />

                        <Text id="_IDGenText10"
                            text="Current Version: 1.0"
                            class="sapUiTinyMarginTop" />

                    </VBox>

                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>