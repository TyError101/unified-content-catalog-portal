<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds">

    <Page
        id="_IDGenPage"
        title="Dashboard">

        <content>

            <VBox
                id="_IDGenVBox"
                class="sapUiMediumMargin">

                <Title id="_IDGenTitle"
                    text="Analytics Dashboard"
                    level="H1" />

                <Text id="_IDGenText4"
                    text="Media and Catalog Insights"
                    class="sapUiSmallMarginBottom" />

                <Panel id="_IDGenPanel"
                    headerText="Key Metrics"
                    class="sapUiLargeMarginTop">

                    <HBox id="_IDGenHBox1"
                        wrap="Wrap"
                        justifyContent="SpaceAround"
                        class="sapUiMediumMargin">

                        <GenericTile id="_IDGenGenericTile"
                            header="Total Items"
                            frameType="OneByHalf"
                            class="sapUiSmallMargin">

                            <TileContent id="_IDGenTileContent">

                                <NumericContent id="_IDGenNumericContent"
                                    value="{analytics>/totalItems}" />

                            </TileContent>

                        </GenericTile>

                        <GenericTile id="_IDGenGenericTile1"
                            header="Images"
                            frameType="OneByHalf"
                            class="sapUiSmallMargin">

                            <TileContent id="_IDGenTileContent1">

                                <NumericContent id="_IDGenNumericContent1"
                                    value="{analytics>/totalImages}" />

                            </TileContent>

                        </GenericTile>

                        <GenericTile id="_IDGenGenericTile2"
                            header="Videos"
                            frameType="OneByHalf"
                            class="sapUiSmallMargin">

                            <TileContent id="_IDGenTileContent2">

                                <NumericContent id="_IDGenNumericContent2"
                                    value="{analytics>/totalVideos}" />

                            </TileContent>

                        </GenericTile>

                        <GenericTile id="_IDGenGenericTile3"
                            header="Documents"
                            frameType="OneByHalf"
                            class="sapUiSmallMargin">

                            <TileContent id="_IDGenTileContent3">

                                <NumericContent id="_IDGenNumericContent3"
                                    value="{analytics>/totalDocuments}" />

                            </TileContent>

                        </GenericTile>

                    </HBox>

                </Panel>

                <Panel id="_IDGenPanel1"
                    headerText="Media Distribution"
                    class="sapUiLargeMarginTop">

                    <viz:VizFrame
                        id="mediaChart"
                        vizType="donut"
                        width="100%"
                        height="300px">

                        <viz:dataset>

                            <viz.data:FlattenedDataset id="_IDGenFlattenedDataset"
                                data="{analytics>/mediaDistribution}">

                                <viz.data:dimensions>

                                    <viz.data:DimensionDefinition id="_IDGenDimensionDefinition"
                                        name="Category"
                                        value="{analytics>category}" />

                                </viz.data:dimensions>

                                <viz.data:measures>

                                    <viz.data:MeasureDefinition id="_IDGenMeasureDefinition"
                                        name="Count"
                                        value="{analytics>count}" />

                                </viz.data:measures>

                            </viz.data:FlattenedDataset>

                        </viz:dataset>

                        <viz:feeds>

                            <viz.feeds:FeedItem id="_IDGenFeedItem"
                                uid="size"
                                type="Measure"
                                values="Count" />

                            <viz.feeds:FeedItem id="_IDGenFeedItem1"
                                uid="color"
                                type="Dimension"
                                values="Category" />

                        </viz:feeds>

                    </viz:VizFrame>

                </Panel>

                <Panel id="_IDGenPanel2"
                    headerText="Recent Uploads"
                    class="sapUiLargeMarginTop">

                    <Table id="_IDGenTable1"
                        items="{analytics>/recentUploads}">

                        <columns>

                            <Column id="_IDGenColumn8">
                                <Text id="_IDGenText5" text="File Name" />
                            </Column>

                            <Column id="_IDGenColumn10">
                                <Text id="_IDGenText6" text="Type" />
                            </Column>

                            <Column id="_IDGenColumn11">
                                <Text id="_IDGenText7" text="Size" />
                            </Column>

                            <Column id="_IDGenColumn12">
                                <Text id="_IDGenText8" text="Uploaded At" />
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem2">

                                <cells>

                                    <Text id="_IDGenText9" text="{analytics>fileName}" />

                                    <Text id="_IDGenText10" text="{analytics>fileType}" />

                                    <Text id="_IDGenText25" text="{analytics>fileSize}" />

                                    <Text id="_IDGenText26" text="{analytics>uploadDate}" />

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </Panel>

            </VBox>

        </content>

    </Page>

</mvc:View>