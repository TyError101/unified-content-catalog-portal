<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="_IDGenPage" title="Dashboard">

        <content>

            <VBox id="_IDGenVBox" class="sapUiMediumMargin">

                <Title id="_IDGenTitle"
                    text="Analytics Dashboard"
                    level="H1" />

                <Text id="_IDGenText1"
                    text="Media &amp; Catalog Insights"
                    class="sapUiSmallMarginBottom" />

                <HBox id="_IDGenHBox1"
                    wrap="Wrap"
                    class="sapUiMediumMarginTop">

                    <GenericTile id="_IDGenGenericTile"
                        header="Total Items"
                        class="sapUiSmallMargin">

                        <TileContent id="_IDGenTileContent">

                            <NumericContent id="_IDGenNumericContent1"
                                value="{analytics>/totalItems}" />

                        </TileContent>

                    </GenericTile>

                    <GenericTile id="_IDGenGenericTile1"
                        header="Images"
                        class="sapUiSmallMargin">

                        <TileContent id="_IDGenTileContent1">

                            <NumericContent id="_IDGenNumericContent2"
                                value="{analytics>/totalImages}" />

                        </TileContent>

                    </GenericTile>

                    <GenericTile id="_IDGenGenericTile2"
                        header="Videos"
                        class="sapUiSmallMargin">

                        <TileContent id="_IDGenTileContent2">

                            <NumericContent id="_IDGenNumericContent3"
                                value="{analytics>/totalVideos}" />

                        </TileContent>

                    </GenericTile>

                    <GenericTile id="_IDGenGenericTile3"
                        header="Documents"
                        class="sapUiSmallMargin">

                        <TileContent id="_IDGenTileContent3">

                            <NumericContent id="_IDGenNumericContent4"
                                value="{analytics>/totalDocuments}" />

                        </TileContent>

                    </GenericTile>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>