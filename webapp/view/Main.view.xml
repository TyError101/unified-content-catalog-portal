<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">

    <tnt:ToolPage id="_IDGenToolPage">

        <!-- Side Navigation -->

        <tnt:sideContent>

            <tnt:SideNavigation id="_IDGenSideNavigation">

                <tnt:NavigationList id="_IDGenNavigationList">

                    <tnt:NavigationListItem id="_IDGenNavigationListItem"
                        text="Dashboard"
                        icon="sap-icon://home"
                        select="onDashboardPress" />

                    <tnt:NavigationListItem id="_IDGenNavigationListItem1"
                        text="Catalog"
                        icon="sap-icon://table-view"
                        select="onCatalogPress" />

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <!-- Main Content -->

        <tnt:mainContents>

            <NavContainer id="pageContainer">

                <mvc:XMLView id="_IDGenXMLView2"
                    viewName="com.rishi.contentcatalogportal.view.Dashboard" />

            </NavContainer>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>