<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m">

    <tnt:ToolPage id="toolPage">

        <tnt:sideContent>

            <tnt:SideNavigation id="_IDGenSideNavigation">

                <tnt:NavigationList id="_IDGenNavigationList">

                    <tnt:NavigationListItem
                        id="_IDGenNavigationListItem1"
                        text="Dashboard"
                        icon="sap-icon://home"
                        select="onDashboardPress" />

                    <tnt:NavigationListItem
                        id="_IDGenNavigationListItem2"
                        text="Catalog"
                        icon="sap-icon://table-view"
                        select="onCatalogPress" />

                    <tnt:NavigationListItem
                        id="_IDGenNavigationListItem3"
                        text="Upload"
                        icon="sap-icon://upload"
                        select="onUploadPress" />

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <tnt:mainContents>

            <NavContainer id="pageContainer" />

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>