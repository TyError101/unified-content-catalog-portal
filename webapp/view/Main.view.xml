<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">

    <tnt:ToolPage id="toolPage">

        <!-- Side Navigation -->
        <tnt:sideContent>

            <tnt:SideNavigation id="_IDGenSideNavigation">

                <tnt:NavigationList id="_IDGenNavigationList">

                    <tnt:NavigationListItem id="_IDGenNavigationListItem"
                        text="Dashboard"
                        icon="sap-icon://home" />

                    <tnt:NavigationListItem id="_IDGenNavigationListItem1"
                        text="Catalog"
                        icon="sap-icon://table-view" />

                    <tnt:NavigationListItem id="_IDGenNavigationListItem2"
                        text="Upload Media"
                        icon="sap-icon://upload" />

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <!-- Main Content -->
        <tnt:mainContents>

            <Page id="_IDGenPage" title="Dashboard">

                <content>

                    <VBox id="_IDGenVBox2" class="sapUiMediumMargin">

                        <Title id="_IDGenTitle"
                            text="Unified Content &amp; Catalog Management Portal"
                            level="H2" />

                        <Text id="_IDGenText14"
                            text="SAPUI5 enterprise application initialized successfully." />

                        <!-- Dashboard Tiles -->

                        <HBox id="_IDGenHBox"
                            wrap="Wrap"
                            class="sapUiLargeMarginTop">

                            <!-- Tile 1 -->

                            <GenericTile id="_IDGenGenericTile"
                                header="Catalog Items"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                frameType="TwoByOne">

                                <tileContent>

                                    <TileContent id="_IDGenTileContent">

                                        <content>

                                            <NumericContent id="_IDGenNumericContent"
                                                value="120"
                                                valueColor="Good" />

                                        </content>

                                    </TileContent>

                                </tileContent>

                            </GenericTile>

                            <!-- Tile 2 -->

                            <GenericTile id="_IDGenGenericTile1"
                                header="Images Uploaded"
                                class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                                frameType="TwoByOne">

                                <tileContent>

                                    <TileContent id="_IDGenTileContent1">

                                        <content>

                                            <NumericContent id="_IDGenNumericContent1"
                                                value="350"
                                                valueColor="Neutral" />

                                        </content>

                                    </TileContent>

                                </tileContent>

                            </GenericTile>

                            <!-- Tile 3 -->

                            <GenericTile id="_IDGenGenericTile2"
                                header="Videos Uploaded"
                                class="sapUiTinyMarginBottom"
                                frameType="TwoByOne">

                                <tileContent>

                                    <TileContent id="_IDGenTileContent2">

                                        <content>

                                            <NumericContent id="_IDGenNumericContent2"
                                                value="48"
                                                valueColor="Critical" />

                                        </content>

                                    </TileContent>

                                </tileContent>

                            </GenericTile>

                        </HBox>

                    </VBox>

                </content>

            </Page>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>