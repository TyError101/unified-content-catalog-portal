<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">

    <tnt:ToolPage id="toolPage">

        <!-- Side Navigation -->
        <tnt:sideContent>

            <tnt:SideNavigation id="_IDGenSideNavigation">

                <tnt:NavigationList id="_IDGenNavigationList">

                    <tnt:NavigationListItem id="_IDGenNavigationListItem1"
                        text="Dashboard"
                        icon="sap-icon://home"
                        select=".onNavToDashboard" />

                    <tnt:NavigationListItem id="_IDGenNavigationListItem2"
                        text="Catalog"
                        icon="sap-icon://table-view"
                        select=".onNavToCatalog" />

                    <tnt:NavigationListItem id="_IDGenNavigationListItem3"
                        text="Upload Media"
                        icon="sap-icon://upload"
                        select=".onNavToUpload" />

                </tnt:NavigationList>

            </tnt:SideNavigation>

        </tnt:sideContent>

        <!-- Main Content -->
        <tnt:mainContents>

            <NavContainer id="navContainer">

                <mvc:XMLView
                    id="dashboardView"
                    viewName="com.rishi.contentcatalogportal.view.Dashboard" />

            </NavContainer>

        </tnt:mainContents>

    </tnt:ToolPage>

</mvc:View>