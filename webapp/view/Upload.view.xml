<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Upload"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified">

    <Page id="_IDGenPage3" title="Upload Media">

        <content>

            <VBox id="_IDGenVBox" class="sapUiMediumMargin">

                <Title id="_IDGenTitle2"
                    text="Media Upload Center"
                    level="H2" />

                <Text id="_IDGenText7"
                    text="Upload images, videos, and digital assets." />

                <Toolbar id="_IDGenToolbar1" class="sapUiMediumMarginTop">

                    <unified:FileUploader
                        id="fileUploader"
                        width="400px"
                        buttonText="Choose File"
                        change="onFileChange"
                        fileType="jpg,jpeg,png,mp4" />

                </Toolbar>

                <VBox id="_IDGenVBox3" class="sapUiLargeMarginTop">

                    <Title id="_IDGenTitle3"
                        text="Upload History"
                        level="H3" />

                    <Table id="_IDGenTable" items="{upload>/uploads}">

                        <columns>

                            <Column id="_IDGenColumn3">
                                <Text id="_IDGenText8" text="File Name" />
                            </Column>

                            <Column id="_IDGenColumn5">
                                <Text id="_IDGenText9" text="Type" />
                            </Column>

                            <Column id="_IDGenColumn6">
                                <Text id="_IDGenText10" text="Size" />
                            </Column>

                            <Column id="_IDGenColumn7">
                                <Text id="_IDGenText11" text="Uploaded At" />
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem1">

                                <cells>

                                    <Text id="_IDGenText12" text="{upload>fileName}" />

                                    <Text id="_IDGenText13" text="{upload>fileType}" />

                                    <Text id="_IDGenText14" text="{upload>fileSize}" />

                                    <Text id="_IDGenText15" text="{upload>uploadDate}" />

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>