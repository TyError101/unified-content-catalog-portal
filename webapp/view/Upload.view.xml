<mvc:View
    controllerName="com.rishi.contentcatalogportal.controller.Upload"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page id="_IDGenPage2"
        title="Upload Media">

        <content>

            <VBox id="_IDGenVBox1"
                class="sapUiMediumMargin">

                <Title id="_IDGenTitle2"
                    text="Media Upload Center"
                    level="H2" />

                <Text id="_IDGenText2"
                    text="Upload images, videos and digital assets."
                    class="sapUiSmallMarginBottom" />

                <MessageStrip id="_IDGenMessageStrip"
                    text="Supported formats: JPG, PNG, MP4"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <Panel id="_IDGenPanel3"
                    headerText="Upload File"
                    class="sapUiMediumMarginTop">

                    <VBox id="_IDGenVBox2"
                        class="sapUiMediumMargin">

                        <core:HTML id="_IDGenHTML"
                            preferDOM="true"
                            content='&lt;input type="file" id="realFileInput" accept=".jpg,.jpeg,.png,.mp4" style="margin-top:10px;margin-bottom:20px;" /&gt;' />

                    </VBox>

                </Panel>

                <Panel id="_IDGenPanel4"
                    headerText="Upload History"
                    class="sapUiLargeMarginTop">

                    <Table id="_IDGenTable"
                        items="{upload>/uploads}">

                        <columns>

                            <Column id="_IDGenColumn4">
                                <Text id="_IDGenText3" text="File Name" />
                            </Column>

                            <Column id="_IDGenColumn5">
                                <Text id="_IDGenText17" text="Type" />
                            </Column>

                            <Column id="_IDGenColumn6">
                                <Text id="_IDGenText18" text="Size" />
                            </Column>

                            <Column id="_IDGenColumn7">
                                <Text id="_IDGenText19" text="Uploaded At" />
                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem id="_IDGenColumnListItem1">

                                <cells>

                                    <Text id="_IDGenText20" text="{upload>fileName}" />

                                    <Text id="_IDGenText21" text="{upload>fileType}" />

                                    <Text id="_IDGenText22" text="{upload>fileSize}" />

                                    <Text id="_IDGenText23" text="{upload>uploadDate}" />

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </Panel>

                <Panel id="_IDGenPanel5"
                    headerText="Preview"
                    class="sapUiLargeMarginTop">

                    <VBox
                        id="previewBox"
                        class="sapUiMediumMargin" />

                </Panel>

                <Button id="_IDGenButton2"
                    text="Upload Media"
                    icon="sap-icon://upload"
                    type="Emphasized"
                    press="onProcessUpload"
                    class="sapUiLargeMarginTop" />

            </VBox>

        </content>

    </Page>

</mvc:View>