<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="_IDGenDialog1"
        title="Add Catalog Item"
        draggable="true"
        resizable="true">

        <VBox id="_IDGenVBox5" class="sapUiMediumMargin">

            <Label id="_IDGenLabel3" text="ID" />

            <Input id="dialogInputId" />

            <Label id="_IDGenLabel4"
                text="Name"
                class="sapUiSmallMarginTop" />

            <Input id="dialogInputName" />

            <Label id="_IDGenLabel5"
                text="Category"
                class="sapUiSmallMarginTop" />

            <Select id="dialogSelectCategory">

                <items>

                    <core:Item id="_IDGenItem3"
                        key="Image"
                        text="Image" />

                    <core:Item id="_IDGenItem4"
                        key="Document"
                        text="Document" />

                    <core:Item id="_IDGenItem5"
                        key="Video"
                        text="Video" />

                </items>

            </Select>

        </VBox>

        <beginButton>

            <Button id="_IDGenButton4"
                text="Save"
                type="Emphasized"
                press="onSaveItem" />

        </beginButton>

        <endButton>

            <Button id="_IDGenButton5"
                text="Cancel"
                press="onCloseDialog" />

        </endButton>

    </Dialog>

</core:FragmentDefinition>