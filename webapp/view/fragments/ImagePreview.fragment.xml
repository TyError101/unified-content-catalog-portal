<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="_IDGenDialog2"
        title="Image Preview"
        contentWidth="700px"
        contentHeight="600px">

        <VBox id="_IDGenVBox6" class="sapUiMediumMargin">

            <Image
                id="previewImage"
                width="100%"
                densityAware="false" />

        </VBox>

        <beginButton>

            <Button id="_IDGenButton1"
                text="Close"
                press="onClosePreviewDialog" />

        </beginButton>

    </Dialog>

</core:FragmentDefinition>